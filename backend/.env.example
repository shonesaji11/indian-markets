# Copy to backend/.env and fill in. Never commit .env.

# "angelone" for real data, "fake" for a synthetic offline provider.
MARKETS_PROVIDER=angelone

# From https://smartapi.angelbroking.com/ (create an app to get the API key).
MARKETS_ANGEL_API_KEY=
MARKETS_ANGEL_CLIENT_CODE=
MARKETS_ANGEL_PIN=
# The base32 secret shown when you enable TOTP for SmartAPI (not a 6-digit code).
MARKETS_ANGEL_TOTP_SECRET=

# Optional: where the DuckDB file lives (default backend/data/markets.duckdb)
# MARKETS_DB_PATH=
